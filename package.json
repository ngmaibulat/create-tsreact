{
  "name": "create-tsreact-workspace",
  "version": "0.0.0",
  "description": "Workspace root - the published package is packages/cli",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier packages/*/src --check",
    "format:fix": "prettier packages/*/src --write",
    "lint": "eslint packages/*/src",
    "typecheck": "tsc --noEmit -p packages/bruno && tsc --noEmit -p packages/cli",
    "build": "pnpm --filter create-tsreact run build",
    "build-watch": "pnpm --filter create-tsreact run build-watch",
    "test": "pnpm --filter create-tsreact run test",
    "prepare": "husky install"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "eslint": "^8.27.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  }
}
